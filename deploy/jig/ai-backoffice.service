[Unit]
Description=AI Kundetypeassistent administrator service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-kundetype
Group=ai-kundetype
WorkingDirectory=/opt/ai-kundetypeassistent/current
Environment=NODE_ENV=production
Environment=PUBLIC_ORIGIN=https://ai.igurl.dk
Environment=PORT=8765
Environment=STATE_DIR=/var/lib/ai-kundetypeassistent
EnvironmentFile=/etc/ai-kundetypeassistent-release.env
ExecStart=/opt/ai-kundetypeassistent/runtime/bin/node /opt/ai-kundetypeassistent/current/server/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=ai-kundetypeassistent
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-kundetypeassistent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
