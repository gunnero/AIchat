{
  "name": "kundetypeassistent-backoffice",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run test:ui && npm run build",
    "test:ui": "vitest run --environment jsdom src/*.test.tsx"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource/source-sans-3": "5.3.1",
    "@phosphor-icons/react": "2.1.10",
    "fastify": "5.12.7",
    "nodemailer": "10.1.5",
    "otpauth": "9.5.2",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-qr-code": "2.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
